# Credenciais do MongoDB (Root)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=sua_senha_segura_aqui

# String de conexão do MongoDB (Atlas ou local)
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/despesas

# Token do bot do Telegram (obtido com o @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABC-DEF_seu_token_aqui

# Chat ID padrão para onde as notificações serão enviadas
# (obtenha o seu conversando com @userinfobot no Telegram)
TELEGRAM_CHAT_ID=123456789

# Chave secreta para proteger o endpoint de notificação (cron)
CRON_SECRET=uma-string-secreta-aleatoria

# Quantos dias antes do vencimento o aviso deve ser enviado
DIAS_DE_AVISO=3
